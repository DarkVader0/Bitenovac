<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Bitenovac.RemoteBuildTool.Integration.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
        <PropertyGroup>
            <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
        </PropertyGroup>
        <WriteLinesToFile
            File="$(BuildInfoFile)"
            Lines="namespace $(RootNamespace)%3B;internal static class BuildInfo { public const string TargetFramework = &quot;$(TargetFramework)&quot;%3B }"
            Overwrite="true"
            WriteOnlyWhenDifferent="true"/>
        <ItemGroup>
            <Compile Include="$(BuildInfoFile)"/>
            <FileWrites Include="$(BuildInfoFile)"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\src\tools\Bitenovac.RemoteBuildTool.Service\Bitenovac.RemoteBuildTool.Service.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator"/>
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\..\Directory.Packages.props" Link="Directory.Packages.props" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\..\..\global.json" Link="global.json" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\..\..\nuget.config" Link="nuget.config" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\..\..\.config\dotnet-tools.json" Link="dotnet-tools.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
