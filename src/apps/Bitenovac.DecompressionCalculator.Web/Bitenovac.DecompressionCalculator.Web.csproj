    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\libraries\Bitenovac.DecompressionCalculator.Model\Bitenovac.DecompressionCalculator.Model.csproj"/>
    </ItemGroup>

</Project>
