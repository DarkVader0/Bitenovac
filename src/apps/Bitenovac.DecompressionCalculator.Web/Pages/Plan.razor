@page "/plan/{Id:guid}"
@inject PlanStore Store
@inject NavigationManager Navigation

<PageTitle>@(_plan?.Name ?? "Bitenovac")</PageTitle>

@if (_missing)
{
    <h1>Plan not found</h1>
    <p>This plan is not saved in this browser.</p>
    <a href="plans">Show saved plans</a>
    return;
}

@if (_plan is null || _view is null)
{
    return;
}

<PlanSidebar Current="_plan"/>

<header class="plan-header no-print">
    <a class="icon-button plans-button" href="plans" title="Plans" aria-label="Plans">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
        </svg>
    </a>
    <input class="plan-name" type="text" aria-label="Plan name" value="@_plan.Name"
           @onchange="args => ChangeAsync(_plan with { Name = args.Value as string ?? string.Empty })"/>
    <button type="button" class="icon-button" title="Share" aria-label="Share" @onclick="() => _shareOpen = true">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/>
        </svg>
    </button>
    <button type="button" class="icon-button settings-button" title="Settings" aria-label="Settings" aria-expanded="@_settingsOpen"
            @onclick="() => _settingsOpen = true">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
        </svg>
        @if (SettingsHaveIssues)
        {
            <span class="badge" aria-label="Settings need attention"></span>
        }
    </button>
</header>

<h1 class="print-only">@(string.IsNullOrWhiteSpace(_plan.Name) ? FileNames.Fallback : _plan.Name)</h1>

<DiveTabs Count="_plan.Dives.Count" Selected="_selected" SelectedChanged="index => _selected = index"
          DivesWithIssues="DivesWithIssues" OnAdd="() => AddDiveAsync(_plan)"/>

<DiveEditor Value="_plan.Dives[_selected]" Number="_selected + 1" CanRemove="_plan.Dives.Count > 1" Units="_plan.Units"
            Issues="_issues.Scope(nameof(DivePlanDocument.Dives), _selected)" OnRemove="() => RemoveDiveAsync(_plan)"
            ValueChanged="dive => ChangeAsync(_plan with { Dives = ListEdit.Replace(_plan.Dives, _selected, dive) })"/>

@if (_view.PlanIssues.Count > 0)
{
    <section class="card results">
        <h2>Settings are invalid</h2>
        <div class="alert alert-danger">
            <p>No dive can be planned until these are fixed:</p>
            <ul>
                @foreach (var issue in _view.PlanIssues)
                {
                    <li>@IssueText.Describe(issue)</li>
                }
            </ul>
            <button type="button" class="secondary" @onclick="() => _settingsOpen = true">Open settings</button>
        </div>
    </section>
}
else
{
    var title = _plan.Dives.Count > 1 ? $"Results · Dive {_selected + 1}" : "Results";
    @if (_view.Results[_selected] is { } result)
    {
        <DiveResultView Result="result" Units="_plan.Units" Title="@title"/>
    }
    else
    {
        <section class="card results">
            <h2>@title</h2>
            @if (_view.IssuesOf(_selected) is { Count: > 0 } issues)
            {
                <div class="alert alert-danger">
                    <p>@(_plan.Dives.Count > 1 ? $"Dive {_selected + 1} is invalid:" : "The dive is invalid:")</p>
                    <ul>
                        @foreach (var issue in issues)
                        {
                            <li>@IssueText.Describe(issue)</li>
                        }
                    </ul>
                </div>
            }
            @if (_view.FirstInvalidDive is { } blocking && blocking < _selected)
            {
                <div class="alert alert-warning">
                    <p>
                        This dive can't be planned until dive @(blocking + 1) is fixed: every dive is planned on
                        the nitrogen and helium left from the dives before it.
                    </p>
                    <button type="button" class="secondary" @onclick="() => _selected = blocking">Go to dive @(blocking + 1)</button>
                </div>
            }
        </section>
    }

    @if (_plan.Dives.Count > 1)
    {
        <SeriesSummary Plan="_plan" View="_view" Selected="_selected" SelectedChanged="index => _selected = index"/>
    }
}

@if (_shareOpen)
{
    <ShareSheet Plan="_plan" Dive="_selected" OnClose="() => _shareOpen = false"/>
}

@if (_settingsOpen)
{
    <div class="drawer-backdrop settings-backdrop" @onclick="() => _settingsOpen = false"></div>
}

<aside class="drawer settings-panel @(_settingsOpen ? "open" : null)" role="@(_settingsOpen ? "dialog" : "complementary")"
       aria-modal="@(_settingsOpen ? "true" : null)" aria-label="Settings" @onkeydown="CloseOnEscape">
    <div class="drawer-header">
        <h2>Settings</h2>
        <button type="button" class="settings-done" @onclick="() => _settingsOpen = false">Done</button>
    </div>

    <section class="card">
        <div class="field-grid">
            <div class="field">
                <span class="field-label">Units</span>
                <div class="button-row">
                    <button type="button" class="@(_plan.Units == UnitSystem.Metric ? null : "secondary")"
                            aria-pressed="@(_plan.Units == UnitSystem.Metric)"
                            @onclick="() => ChangeAsync(PlanConverter.Convert(_plan, UnitSystem.Metric))">
                        Metric
                    </button>
                    <button type="button" class="@(_plan.Units == UnitSystem.Imperial ? null : "secondary")"
                            aria-pressed="@(_plan.Units == UnitSystem.Imperial)"
                            @onclick="() => ChangeAsync(PlanConverter.Convert(_plan, UnitSystem.Imperial))">
                        Imperial
                    </button>
                </div>
            </div>
            <div class="field another-plan">
                <span class="field-label">Another plan</span>
                <button type="button" class="secondary" @onclick="() => StartOverAsync(_plan.Units)"><Icon Name="IconName.Add"/>New plan</button>
            </div>
        </div>
    </section>

    <AlgorithmEditor Value="_plan.Algorithm" Issues="_issues.Scope(nameof(DivePlanDocument.Algorithm))"
                     ValueChanged="algorithm => ChangeAsync(_plan with { Algorithm = algorithm })"/>

    <SettingsEditor Value="_plan.Settings" Units="_plan.Units" Issues="_issues.Scope(nameof(DivePlanDocument.Settings))"
                    ValueChanged="settings => ChangeAsync(_plan with { Settings = settings })"/>
</aside>

@code {
    private DivePlanDocument? _plan;
    private PlanView? _view;
    private IssueMap _issues = IssueMap.Empty;
    private bool _settingsOpen;
    private bool _shareOpen;
    private bool _missing;
    private Guid _loadedId;
    private int _selected;

    [Parameter]
    public Guid Id { get; set; }

    private IReadOnlySet<int> DivesWithIssues => _issues.IndexesWithIssues(nameof(DivePlanDocument.Dives));

    private bool SettingsHaveIssues => _view?.PlanIssues.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId)
        {
            return;
        }

        _loadedId = Id;
        _selected = 0;
        _settingsOpen = false;
        var saved = await Store.LoadAsync(Id);
        _missing = saved is not { Dives.Count: > 0 };
        if (saved is { Dives.Count: > 0 })
        {
            Show(saved with { Dives = [.. saved.Dives.Select(CylinderRoles.Apply)] });
            await Store.MarkOpenedAsync(Id);
        }
    }

    private async Task StartOverAsync(UnitSystem units)
    {
        var plan = PlanCopies.New(units, DateTime.UtcNow);
        await Store.SaveAsync(plan);
        Navigation.NavigateTo($"plan/{plan.Id:D}");
    }

    private async Task AddDiveAsync(DivePlanDocument plan)
    {
        _selected = plan.Dives.Count;
        await ChangeAsync(plan with { Dives = ListEdit.Add(plan.Dives, NewInputs.NextDive(plan)) });
    }

    private async Task RemoveDiveAsync(DivePlanDocument plan)
    {
        var removed = _selected;
        _selected = Math.Max(0, removed - 1);
        await ChangeAsync(plan with { Dives = ListEdit.RemoveAt(plan.Dives, removed) });
    }

    private void CloseOnEscape(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _settingsOpen = false;
        }
    }

    private async Task ChangeAsync(DivePlanDocument plan)
    {
        var updated = plan with { ModifiedAt = DateTime.UtcNow };
        Show(updated);
        await Store.SaveAsync(updated);
    }

    private void Show(DivePlanDocument plan)
    {
        _plan = plan;
        _selected = Math.Clamp(_selected, 0, plan.Dives.Count - 1);
        _view = PlanView.Calculate(plan);
        _issues = IssueMap.From(_view.Issues);
    }
}
