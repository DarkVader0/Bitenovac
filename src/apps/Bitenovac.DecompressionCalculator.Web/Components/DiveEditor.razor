<section class="card no-print">
    <div class="card-header">
        <h2>Dive @Number</h2>
        @if (CanRemove)
        {
            @if (_confirmRemove)
            {
                <div class="button-row">
                    <button type="button" class="danger" @onclick="RemoveAsync">Remove</button>
                    <button type="button" class="secondary" @onclick="() => _confirmRemove = false">Keep</button>
                </div>
            }
            else
            {
                <button type="button" class="secondary" @onclick="() => _confirmRemove = true">Remove dive</button>
            }
        }
    </div>

    @if (Number > 1)
    {
        <div class="field-grid surface-interval">
            <NumberField Label="Surface interval before this dive" Unit="min" Value="Value.SurfaceIntervalMinutes"
                         Issue="@Issues[nameof(DiveInput.SurfaceIntervalMinutes)]"
                         ValueChanged="value => ChangeAsync(Value with { SurfaceIntervalMinutes = value })"/>
        </div>
    }

    <CircuitEditor Value="Value.Circuit" Issues="Issues.Scope(nameof(DiveInput.Circuit))"
                   ValueChanged="circuit => ChangeAsync(Value with { Circuit = circuit })"/>

    <h3>Levels</h3>
    @if (Issues[nameof(DiveInput.Levels)] is { } levelsIssue)
    {
        <p class="validation-message">@levelsIssue</p>
    }
    @{
        var removableLevels = Value.Levels.Count > 1;
    }
    <table class="input-table">
        <colgroup>
            <col/>
            <col/>
            @if (removableLevels)
            {
                <col class="col-remove"/>
            }
        </colgroup>
        <thead>
        <tr>
            <th>Depth <span class="unit">@Labels.Depth</span></th>
            <th>Time <span class="unit">min</span></th>
            @if (removableLevels)
            {
                <th><span class="visually-hidden">Remove</span></th>
            }
        </tr>
        </thead>
        <tbody>
        @for (var index = 0; index < Value.Levels.Count; index++)
        {
            var at = index;
            var level = Value.Levels[at];
            var issues = Issues.Scope(nameof(DiveInput.Levels), at);
            <tr>
                <td>
                    <NumberCell Label="@($"Level {at + 1} depth in {Labels.Depth}")" Value="level.Depth"
                                Invalid="issues[nameof(LevelInput.Depth)] is not null"
                                ValueChanged="value => ChangeLevelAsync(at, level with { Depth = value })"/>
                </td>
                <td>
                    <NumberCell Label="@($"Level {at + 1} time in minutes")" Value="level.DurationMinutes"
                                Invalid="issues[nameof(LevelInput.DurationMinutes)] is not null"
                                ValueChanged="value => ChangeLevelAsync(at, level with { DurationMinutes = value })"/>
                </td>
                @if (removableLevels)
                {
                    <td>
                        <button type="button" class="icon-button" title="Remove level" aria-label="Remove level @(at + 1)"
                                @onclick="() => ChangeAsync(Value with { Levels = ListEdit.RemoveAt(Value.Levels, at) })">✕</button>
                    </td>
                }
            </tr>
            <RowIssues Columns="@(removableLevels ? 3 : 2)" Messages="[issues[nameof(LevelInput.Depth)], issues[nameof(LevelInput.DurationMinutes)]]"/>
        }
        </tbody>
    </table>
    <button type="button" class="secondary" @onclick="() => ChangeAsync(Value with { Levels = ListEdit.Add(Value.Levels, NewInputs.Level(Value)) })">
        Add level
    </button>

    <h3>Cylinders</h3>
    @if (Issues[nameof(DiveInput.Cylinders)] is { } cylindersIssue)
    {
        <p class="validation-message">@cylindersIssue</p>
    }
    @{
        var imperial = Units == UnitSystem.Imperial;
        var removableCylinders = Value.Cylinders.Count > 1;
        var columns = (imperial ? 6 : 5) + (removableCylinders ? 1 : 0);
    }
    <div class="table-scroll">
        <table class="input-table @(imperial ? "cylinders-imperial" : "cylinders")">
            <colgroup>
                <col/>
                <col/>
                <col/>
                @if (imperial)
                {
                    <col/>
                }
                <col/>
                <col class="col-role"/>
                @if (removableCylinders)
                {
                    <col class="col-remove"/>
                }
            </colgroup>
            <thead>
            <tr>
                <th>O2 <span class="unit">%</span></th>
                <th>He <span class="unit">%</span></th>
                <th>Size <span class="unit">@Labels.CylinderSize</span></th>
                @if (imperial)
                {
                    <th>Rated <span class="unit">@Labels.Pressure</span></th>
                }
                <th>Fill <span class="unit">@Labels.Pressure</span></th>
                <th>Use</th>
                @if (removableCylinders)
                {
                    <th><span class="visually-hidden">Remove</span></th>
                }
            </tr>
            </thead>
            <tbody>
            @for (var index = 0; index < Value.Cylinders.Count; index++)
            {
                var at = index;
                var cylinder = Value.Cylinders[at];
                var issues = Issues.Scope(nameof(DiveInput.Cylinders), at);
                var name = $"Cylinder {at + 1}";
                <tr>
                    <td>
                        <NumberCell Label="@($"{name} oxygen in %")" Value="cylinder.OxygenPercent"
                                    Invalid="issues[nameof(CylinderInput.OxygenPercent)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, cylinder with { OxygenPercent = value })"/>
                    </td>
                    <td>
                        <NumberCell Label="@($"{name} helium in %")" Value="cylinder.HeliumPercent"
                                    Invalid="issues[nameof(CylinderInput.HeliumPercent)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, cylinder with { HeliumPercent = value })"/>
                    </td>
                    <td>
                        <NumberCell Label="@($"{name} size in {Labels.CylinderSize}")" Value="cylinder.Size"
                                    Invalid="issues[nameof(CylinderInput.Size)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, cylinder with { Size = value })"/>
                    </td>
                    @if (imperial)
                    {
                        <td>
                            <NumberCell Label="@($"{name} rated pressure in {Labels.Pressure}")" Value="cylinder.RatedPressure"
                                        Invalid="issues[nameof(CylinderInput.RatedPressure)] is not null"
                                        ValueChanged="value => ChangeCylinderAsync(at, cylinder with { RatedPressure = value })"/>
                        </td>
                    }
                    <td>
                        <NumberCell Label="@($"{name} fill pressure in {Labels.Pressure}")" Value="cylinder.StartPressure"
                                    Invalid="issues[nameof(CylinderInput.StartPressure)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, cylinder with { StartPressure = value })"/>
                    </td>
                    <td>
                        @if (CylinderRoles.Resolve(Value.Circuit, cylinder) == CylinderPurpose.Oxygen)
                        {
                            <span class="cell-static">O2</span>
                        }
                        else
                        {
                            <SelectCell TValue="CylinderPurpose" Label="@($"{name} used as")" Options="CylinderRoles.Selectable(Value.Circuit)"
                                        Text="purpose => Display.ShortName(purpose, Value.Circuit)" Value="cylinder.Purpose"
                                        Invalid="issues[nameof(CylinderInput.Purpose)] is not null"
                                        ValueChanged="value => ChangeCylinderAsync(at, cylinder with { Purpose = value })"/>
                        }
                    </td>
                    @if (removableCylinders)
                    {
                        <td>
                            <button type="button" class="icon-button" title="Remove cylinder" aria-label="Remove @name"
                                    @onclick="() => ChangeAsync(Value with { Cylinders = ListEdit.RemoveAt(Value.Cylinders, at) })">✕</button>
                        </td>
                    }
                </tr>
                <RowIssues Columns="columns"
                           Messages="[issues[nameof(CylinderInput.OxygenPercent)], issues[nameof(CylinderInput.HeliumPercent)],
                                      issues[nameof(CylinderInput.Size)], issues[nameof(CylinderInput.RatedPressure)],
                                      issues[nameof(CylinderInput.StartPressure)], issues[nameof(CylinderInput.Purpose)]]"/>
            }
            </tbody>
        </table>
    </div>
    <button type="button" class="secondary" @onclick="() => ChangeAsync(Value with { Cylinders = ListEdit.Add(Value.Cylinders, NewInputs.Cylinder(Units)) })">
        Add cylinder
    </button>
</section>

@code {
    private bool _confirmRemove;
    private int _shownNumber;

    [Parameter]
    public int Number { get; set; } = 1;

    [Parameter]
    public bool CanRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter, EditorRequired]
    public DiveInput Value { get; set; } = default!;

    [Parameter]
    public EventCallback<DiveInput> ValueChanged { get; set; }

    [Parameter]
    public UnitSystem Units { get; set; }

    [Parameter]
    public IssueMap Issues { get; set; } = IssueMap.Empty;

    private UnitLabels Labels => UnitLabels.For(Units);

    protected override void OnParametersSet()
    {
        if (Number != _shownNumber)
        {
            _shownNumber = Number;
            _confirmRemove = false;
        }
    }

    private Task ChangeAsync(DiveInput dive) => ValueChanged.InvokeAsync(CylinderRoles.Apply(dive));

    private async Task RemoveAsync()
    {
        _confirmRemove = false;
        await OnRemove.InvokeAsync();
    }

    private Task ChangeLevelAsync(int index, LevelInput level) =>
        ChangeAsync(Value with { Levels = ListEdit.Replace(Value.Levels, index, level) });

    private Task ChangeCylinderAsync(int index, CylinderInput cylinder) =>
        ChangeAsync(Value with { Cylinders = ListEdit.Replace(Value.Cylinders, index, cylinder) });
}
