<span class="phase-icon phase-@Kind.ToString().ToLowerInvariant()" role="img" aria-label="@Display.Name(Kind)" title="@Display.Name(Kind)">
    <Icon Name="IconOf(Kind)"/>
</span>

@code {
    [Parameter, EditorRequired]
    public SegmentKind Kind { get; set; }

    private static IconName IconOf(SegmentKind kind) => kind switch
    {
        SegmentKind.Descent => IconName.Descent,
        SegmentKind.Bottom => IconName.Level,
        SegmentKind.Ascent => IconName.Ascent,
        SegmentKind.Stop or SegmentKind.SafetyStop => IconName.Stop,
        _ => IconName.GasSwitch
    };
}
