<div class="drawer-backdrop" @onclick="OnClose"></div>
<aside class="share-sheet gas-tools" role="dialog" aria-modal="true" aria-label="Gas tools" @onkeydown="CloseOnEscape">
    <div class="drawer-header">
        <h2>Gas tools</h2>
        <button type="button" class="secondary" @onclick="OnClose"><Icon Name="IconName.Close"/>Close</button>
    </div>
    <p class="block-note">
        Worked out in this dive's environment (@Names.Of(Settings.Salinity), altitude @Display.Number(Settings.Altitude) @Labels.Depth).
        Oxygen @(Settings.OxygenNarcotic ? "counts" : "does not count") as narcotic in END; change it in the plan settings, under Gas.
    </p>

    <section class="gas-tool">
        <h3>Maximum operating depth</h3>
        <div class="field-pair">
            <NumberField Label="O₂" Unit="%" Value="_modOxygen" ValueChanged="value => _modOxygen = value"/>
            <NumberField Label="PO₂ limit" Unit="bar" Value="_modPo2" ValueChanged="value => _modPo2 = value"/>
        </div>
        <p class="gas-tool-result" role="status">
            MOD <strong>@Result(() => $"{Display.Number(Math.Floor(GasMath.MaximumOperatingDepth(_modOxygen, _modPo2, Settings, Units)))} {Labels.Depth}")</strong>
        </p>
    </section>

    <section class="gas-tool">
        <h3>Equivalent narcotic depth</h3>
        <div class="field-pair">
            <NumberField Label="O₂" Unit="%" Value="_endOxygen" ValueChanged="value => _endOxygen = value"/>
            <NumberField Label="He" Unit="%" Value="_endHelium" ValueChanged="value => _endHelium = value"/>
        </div>
        <NumberField Label="Depth" Unit="@Labels.Depth" Value="_endDepth" ValueChanged="value => _endDepth = value"/>
        <p class="gas-tool-result" role="status">
            END <strong>@Result(() => $"{Display.Number(Math.Ceiling(GasMath.EquivalentNarcoticDepth(_endOxygen, _endHelium, _endDepth, Settings, Units)))} {Labels.Depth}")</strong>
            · density <strong>@Result(() => $"{Display.Number(GasMath.Density(_endOxygen, _endHelium, _endDepth, Settings, Units), 1)} g/L")</strong>
        </p>
    </section>

    <section class="gas-tool">
        <h3>Best mix</h3>
        <NumberField Label="Deepest depth" Unit="@Labels.Depth" Value="_mixDepth" ValueChanged="value => _mixDepth = value"/>
        <div class="field-pair">
            <NumberField Label="PO₂ limit" Unit="bar" Value="_mixPo2" ValueChanged="value => _mixPo2 = value"/>
            <NumberField Label="END limit" Unit="@Labels.Depth" Value="_mixEnd" ValueChanged="value => _mixEnd = value"/>
        </div>
        <p class="gas-tool-result" role="status">Best mix <strong>@Result(BestMixText)</strong></p>
    </section>
</aside>

@code {
    private double _modOxygen = 50;
    private double _modPo2;
    private double _endOxygen = 21;
    private double _endHelium = 35;
    private double _endDepth;
    private double _mixDepth;
    private double _mixPo2;
    private double _mixEnd;

    [Parameter, EditorRequired]
    public PlannerSettings Settings { get; set; } = default!;

    [Parameter]
    public UnitSystem Units { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private UnitLabels Labels => UnitLabels.For(Units);

    protected override void OnInitialized()
    {
        var imperial = Units == UnitSystem.Imperial;
        _modPo2 = Settings.DecoPo2;
        _mixPo2 = Settings.BottomPo2;
        _endDepth = imperial ? 150 : 45;
        _mixDepth = imperial ? 200 : 60;
        _mixEnd = imperial ? 100 : 30;
    }

    private string BestMixText()
    {
        var mix = GasMath.BestMix(_mixDepth, _mixPo2, _mixEnd, Settings, Units);
        return GasMixture.FromPercent(mix.PercentO2, mix.PercentHe).ToString();
    }

    private static string Result(Func<string> calculate)
    {
        try
        {
            return calculate();
        }
        catch (ArgumentOutOfRangeException)
        {
            return "–";
        }
    }

    private Task CloseOnEscape(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
