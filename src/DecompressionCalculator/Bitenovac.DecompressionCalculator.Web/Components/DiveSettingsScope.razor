@if (DiveCount > 1)
{
    <section class="card settings-scope">
        <CheckField @key="_resets" Label="@WebText.ApplyToAllDives" Value="Shared" ValueChanged="OnChangeAsync"/>
        @if (_confirm)
        {
            <p class="scope-note">@Localized.Format(WebText.ReplaceOwnSettings, DiveName)</p>
            <div class="button-row">
                <button type="button" class="danger" @onclick="ReplaceAsync">@WebText.Replace</button>
                <button type="button" class="secondary" @onclick="Keep">@WebText.Keep</button>
            </div>
        }
        else
        {
            <p class="scope-note">
                @if (Shared)
                {
                    @WebText.SettingsShared
                }
                else
                {
                    @Localized.Format(WebText.SettingsOwn, DiveName)
                }
            </p>
        }
    </section>
}

@code {
    private bool _confirm;
    private int _resets;

    [Parameter, EditorRequired]
    public string DiveName { get; set; } = "";

    [Parameter]
    public int DiveCount { get; set; }

    [Parameter]
    public bool Shared { get; set; }

    [Parameter]
    public bool HasChanges { get; set; }

    [Parameter]
    public EventCallback<bool> SharedChanged { get; set; }

    private Task OnChangeAsync(bool shared)
    {
        if (shared && HasChanges)
        {
            _confirm = true;
            return Task.CompletedTask;
        }

        _confirm = false;
        return SharedChanged.InvokeAsync(shared);
    }

    private void Keep()
    {
        _confirm = false;
        _resets++;
    }

    private Task ReplaceAsync()
    {
        _confirm = false;
        return SharedChanged.InvokeAsync(true);
    }
}
