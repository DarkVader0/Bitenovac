<label class="field field-check">
    <input type="checkbox" checked="@Value" @onchange="OnChangeAsync"/>
    <span class="field-label-row"><span class="field-label">@Label</span><FieldInfo Text="@Hint"/></span>
</label>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    private Task OnChangeAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value is true);
}
