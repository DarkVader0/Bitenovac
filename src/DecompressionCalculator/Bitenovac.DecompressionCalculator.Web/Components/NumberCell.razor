<input type="number" inputmode="decimal" step="any" class="cell-input @(Invalid ? "invalid" : null)" value="@_text"
       aria-label="@Label" aria-invalid="@(Invalid ? "true" : null)" @oninput="OnInputAsync"/>

@code {
    private string _text = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public bool Invalid { get; set; }

    protected override void OnParametersSet()
    {
        if (!NumberInput.Matches(_text, Value))
        {
            _text = NumberInput.Text(Value);
        }
    }

    private Task OnInputAsync(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? "";
        return ValueChanged.InvokeAsync(NumberInput.Parse(args.Value));
    }
}
