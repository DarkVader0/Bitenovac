@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<figure class="profile-chart">
    <svg @ref="_svg" viewBox="0 0 @Width @Height" role="img" aria-label="@WebText.ChartLabel">
        @foreach (var depth in _chart.DepthTicks)
        {
            var y = _chart.Y(depth, Area);
            <g>
                <text class="chart-label" x="@F(Area.Left - 6)" y="@F(y + 4)" text-anchor="end">@Display.Number(depth)</text>
            </g>
        }

        @foreach (var minutes in _chart.TimeTicks)
        {
            var x = _chart.X(minutes, Area);
            <g>
                <text class="chart-label" x="@F(x)" y="@F(Area.Top + Area.Height + 16)" text-anchor="middle">@Display.Number(minutes)</text>
            </g>
        }

        <polygon class="chart-dive" points="@_polyline"/>
        @if (_ceiling.Length > 0)
        {
            <polygon class="chart-ceiling-zone" points="@_ceilingZone"/>
        }
        <polyline class="chart-line" points="@_polyline"/>
        @if (_ceiling.Length > 0)
        {
            <polyline class="chart-ceiling" points="@_ceiling"/>
        }

        @foreach (var stop in _chart.Stops)
        {
            var y = _chart.Y(stop.Depth, Area);
            <line class="@(StopClass(stop))"
                  x1="@F(_chart.X(stop.StartMinutes, Area))" y1="@F(y)" x2="@F(_chart.X(stop.EndMinutes, Area))" y2="@F(y)"/>
            @if (stop.IsGasSwitch)
            {
                <g>
                    <circle class="chart-switch-dot" cx="@F(_chart.X(stop.StartMinutes, Area))" cy="@F(y)" r="3.5"/>
                    <text class="chart-gas" x="@F(_chart.X(stop.StartMinutes, Area) + 5)" y="@F(y - 7)">@stop.Gas</text>
                </g>
            }
        }

        @if (_readout is { } readout)
        {
            var x = _chart.X(readout.Runtime.TotalMinutes, Area);
            <g class="chart-cursor">
                <line x1="@F(x)" y1="@F(Area.Top)" x2="@F(x)" y2="@F(Area.Top + Area.Height)"/>
                @if (readout.Ceiling is { } ceiling)
                {
                    <circle class="chart-cursor-ceiling" cx="@F(x)" cy="@F(_chart.Y(ceiling, Area))" r="3"/>
                }
                <circle class="chart-cursor-depth" cx="@F(x)" cy="@F(_chart.Y(readout.Depth, Area))" r="4"/>
            </g>
        }

        <text class="chart-caption" x="@F(Area.Left + 4)" y="@F(Area.Top - 5)">@Labels.Depth</text>
        <text class="chart-caption" x="@F(Area.Left + Area.Width)" y="@F(Height - 2)" text-anchor="end">@WebText.MinutesUnit</text>
    </svg>
    @if (_readout is { } shown)
    {
        var percent = _chart.X(shown.Runtime.TotalMinutes, Area) / Width * 100;
        var side = percent > 55 ? $"right: calc({F(100 - percent)}% + 0.5rem)" : $"left: calc({F(percent)}% + 0.5rem)";
        <dl class="chart-readout" style="@side" aria-live="polite">
            <div><dt>@WebText.Runtime</dt><dd>@Display.Clock(shown.Runtime)</dd></div>
            <div><dt>@WebText.Depth</dt><dd>@Display.Number(shown.Depth, 1) @Labels.Depth</dd></div>
            <div class="chart-readout-ceiling">
                <dt>@WebText.Ceiling</dt>
                <dd>@(shown.Ceiling is { } ceiling ? $"{Display.Number(ceiling, 1)} {Labels.Depth}" : WebText.CeilingNone)</dd>
            </div>
            <div><dt>@WebText.Tts</dt><dd>@(shown.TimeToSurface is { } tts ? Display.Minutes(tts) : "–")</dd></div>
            <div><dt>@WebText.Gas</dt><dd>@shown.Gas</dd></div>
            <div><dt>@WebText.Ppo2</dt><dd>@Display.Number(shown.OxygenPressure, 2)</dd></div>
            <div><dt>@WebText.Cns</dt><dd>@Display.Number(shown.CnsPercent) %</dd></div>
            <div><dt>@WebText.Otu</dt><dd>@Display.Number(shown.OxygenToleranceUnits)</dd></div>
            <div class="chart-readout-phase"><dt class="visually-hidden">@WebText.Phase</dt><dd>@Display.Name(shown.Kind)</dd></div>
        </dl>
    }
    else
    {
        <p class="chart-readout-hint">@WebText.ChartHint</p>
    }
</figure>

@code {
    private const double Width = 360;
    private const double Height = 220;
    private static readonly ChartArea Area = new(34, 18, 316, 172);

    private ProfileChart _chart = default!;
    private string _polyline = string.Empty;
    private string _ceiling = string.Empty;
    private string _ceilingZone = string.Empty;
    private ChartReadout? _readout;

    private ElementReference _svg;
    private bool _disposed;
    private DotNetObjectReference<ProfileChartView>? _listener;
    private IJSObjectReference? _module;
    private IJSObjectReference? _tracker;

    [Parameter, EditorRequired]
    public DiveResult Result { get; set; } = default!;

    [Parameter]
    public UnitSystem Units { get; set; }

    private UnitLabels Labels => UnitLabels.For(Units);

    protected override void OnParametersSet()
    {
        _chart = ProfileChart.Create(Result, Units);
        _polyline = string.Join(' ', _chart.Points.Select(point => $"{F(_chart.X(point.Minutes, Area))},{F(_chart.Y(point.Depth, Area))}"));
        _ceiling = string.Join(' ', _chart.Ceiling.Select(point => $"{F(_chart.X(point.Minutes, Area))},{F(_chart.Y(point.Depth, Area))}"));
        _ceilingZone = _chart.Ceiling.Count == 0
            ? string.Empty
            : $"{_ceiling} {F(_chart.X(_chart.Ceiling[^1].Minutes, Area))},{F(_chart.Y(0, Area))} {F(_chart.X(_chart.Ceiling[0].Minutes, Area))},{F(_chart.Y(0, Area))}";

        if (_readout is not null)
        {
            _readout = ChartReadout.At(Result, _readout.Runtime.TotalMinutes);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _listener = DotNetObjectReference.Create(this);
        _module = await JS.InvokeGuardedAsync<IJSObjectReference>("import", "./js/chart.js");
        if (_module is null)
        {
            return;
        }

        if (_disposed)
        {
            await _module.DisposeAsync();
            return;
        }

        _tracker = await _module.InvokeGuardedAsync<IJSObjectReference>("track", _svg, _listener);
        if (_disposed && _tracker is not null)
        {
            await _tracker.InvokeVoidGuardedAsync("dispose");
            await _tracker.DisposeAsync();
        }
    }

    [JSInvokable]
    public void Point(double x)
    {
        _readout = ChartReadout.At(Result, (x - Area.Left) / Area.Width * _chart.MaximumMinutes);
        StateHasChanged();
    }

    [JSInvokable]
    public void Leave()
    {
        _readout = null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_tracker is not null)
        {
            await _tracker.InvokeVoidGuardedAsync("dispose");
            await _tracker.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _listener?.Dispose();
    }

    private static string StopClass(ChartStop stop) => stop switch
    {
        { IsGasSwitch: true } => "chart-switch",
        { IsSafetyStop: true } => "chart-stop chart-stop-safety",
        _ => "chart-stop chart-stop-deco"
    };

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
}
