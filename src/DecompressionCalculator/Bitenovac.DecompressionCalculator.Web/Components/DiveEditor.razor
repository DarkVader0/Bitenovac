<section class="card no-print">
    <div class="card-header">
        <h2 class="dive-name-heading">
            <input class="dive-name" type="text" aria-label="@WebText.DiveName" placeholder="@Localized.Format(WebText.DiveNumbered, Number)" maxlength="40"
                   value="@Value.Name" @onchange="args => ChangeAsync(Value with { Name = NameOf(args.Value) })"/>
        </h2>
        @if (CanRemove)
        {
            @if (_confirmRemove)
            {
                <div class="button-row">
                    <button type="button" class="danger" @onclick="RemoveAsync">@WebText.Remove</button>
                    <button type="button" class="secondary" @onclick="() => _confirmRemove = false">@WebText.Keep</button>
                </div>
            }
            else
            {
                <button type="button" class="secondary" @onclick="() => _confirmRemove = true"><Icon Name="IconName.Remove"/>@WebText.RemoveDive</button>
            }
        }
    </div>

    @if (Number > 1)
    {
        <div class="field-grid surface-interval">
            <NumberField @key="(Value.SurfaceIntervalMinutes, 0)" Label="@WebText.SurfaceInterval" Unit="h" Step="1" Value="IntervalHours"
                         ValueChanged="hours => ChangeAsync(Value with { SurfaceIntervalMinutes = hours * 60 + IntervalMinutes })"/>
            <NumberField @key="(Value.SurfaceIntervalMinutes, 1)" Label="@(" ")" Unit="min" Step="1" Value="IntervalMinutes"
                         Issue="@Issues[nameof(DiveInput.SurfaceIntervalMinutes)]"
                         ValueChanged="minutes => ChangeAsync(Value with { SurfaceIntervalMinutes = IntervalHours * 60 + minutes })"/>
        </div>
    }

    <CircuitEditor @key="Number" Value="Value.Circuit" Issues="Issues.Scope(nameof(DiveInput.Circuit))"
                   ValueChanged="circuit => ChangeAsync(Value with { Circuit = circuit })"/>

    <h3>@WebText.Levels</h3>
    @if (Issues[nameof(DiveInput.Levels)] is { } levelsIssue)
    {
        <p class="validation-message">@levelsIssue</p>
    }
    @{
        var removableLevels = Value.Levels.Count > 1;
        var levelColumns = removableLevels ? 4 : 3;
    }
    <table class="input-table levels">
        <colgroup>
            <col/>
            <col/>
            @if (removableLevels)
            {
                <col class="col-remove"/>
            }
            <col class="col-remove"/>
        </colgroup>
        <thead>
        <tr>
            <th>@WebText.Depth <span class="unit">@Labels.Depth</span></th>
            <th>@WebText.Time <span class="unit">min</span></th>
            @if (removableLevels)
            {
                <th><span class="visually-hidden">@WebText.Remove</span></th>
            }
            <th><span class="visually-hidden">@WebText.Add</span></th>
        </tr>
        </thead>
        <tbody>
        @for (var index = 0; index < Value.Levels.Count; index++)
        {
            var at = index;
            var level = Value.Levels[at];
            var issues = Issues.Scope(nameof(DiveInput.Levels), at);
            <tr>
                <td>
                    <NumberCell Label="@Localized.Format(WebText.LevelDepthLabel, at + 1, Labels.Depth)" Value="level.Depth"
                                Invalid="issues[nameof(LevelInput.Depth)] is not null"
                                ValueChanged="value => ChangeLevelAsync(at, level with { Depth = value })"/>
                </td>
                <td>
                    <NumberCell Label="@Localized.Format(WebText.LevelTimeLabel, at + 1)" Value="level.DurationMinutes"
                                Invalid="issues[nameof(LevelInput.DurationMinutes)] is not null"
                                ValueChanged="value => ChangeLevelAsync(at, level with { DurationMinutes = value })"/>
                </td>
                @if (removableLevels)
                {
                    <td>
                        <button type="button" class="icon-button" title="@WebText.RemoveLevel" aria-label="@Localized.Format(WebText.RemoveLevelNumbered, at + 1)"
                                @onclick="() => ChangeAsync(Value with { Levels = ListEdit.RemoveAt(Value.Levels, at) })"><Icon Name="IconName.Remove"/></button>
                    </td>
                }
                <td>
                    <button type="button" class="icon-button" title="@WebText.AddLevelAfter" aria-label="@Localized.Format(WebText.AddLevelAfterNumbered, at + 1)"
                            @onclick="() => ChangeAsync(Value with { Levels = ListEdit.Insert(Value.Levels, at + 1, NewInputs.LevelAfter(level)) })"><Icon Name="IconName.Add"/></button>
                </td>
            </tr>
            <RowIssues Columns="levelColumns" Messages="[issues[nameof(LevelInput.Depth)], issues[nameof(LevelInput.DurationMinutes)]]"/>
        }
        </tbody>
    </table>

    <h3>@WebText.Cylinders</h3>
    @if (Issues[nameof(DiveInput.Cylinders)] is { } cylindersIssue)
    {
        <p class="validation-message">@cylindersIssue</p>
    }
    @{
        var removableCylinders = Value.Cylinders.Count > 1;
        var imperial = Units == UnitSystem.Imperial;
        var columns = (removableCylinders ? 6 : 5) + (imperial ? 1 : 0);
    }
    <div class="table-scroll">
        <table class="input-table cylinders">
            <thead>
            <tr>
                <th class="col-gas phone-only">@WebText.Gas <span class="unit">O2/He</span></th>
                <th class="wide-only">@WebText.O2 <span class="unit">%</span></th>
                <th class="wide-only">@WebText.He <span class="unit">%</span></th>
                <th>@WebText.Size <span class="unit">@Labels.CylinderSize</span></th>
                <th>@WebText.Pressure <span class="unit">@Labels.Pressure</span></th>
                @if (imperial)
                {
                    <th>@WebText.WorkingPressure <span class="unit">@Labels.Pressure</span></th>
                }
                <th class="col-role">@WebText.Use</th>
                @if (removableCylinders)
                {
                    <th class="col-remove"><span class="visually-hidden">@WebText.Remove</span></th>
                }
            </tr>
            </thead>
            <tbody>
            @for (var index = 0; index < Value.Cylinders.Count; index++)
            {
                var at = index;
                var cylinder = Value.Cylinders[at];
                var issues = Issues.Scope(nameof(DiveInput.Cylinders), at);
                var name = Localized.Format(WebText.CylinderNumbered, at + 1);
                <tr>
                    <td class="phone-only">
                        <GasCell Label="@Localized.Format(WebText.CylinderGasLabel, name)" OxygenPercent="cylinder.OxygenPercent" HeliumPercent="cylinder.HeliumPercent"
                                 Invalid="issues[nameof(CylinderInput.OxygenPercent)] is not null || issues[nameof(CylinderInput.HeliumPercent)] is not null"
                                 ValueChanged="gas => ChangeCylinderAsync(at, cylinder with { OxygenPercent = gas.Oxygen, HeliumPercent = gas.Helium })"/>
                    </td>
                    <td class="wide-only">
                        <NumberCell Label="@Localized.Format(WebText.CylinderOxygenLabel, name)" Value="cylinder.OxygenPercent"
                                    Invalid="issues[nameof(CylinderInput.OxygenPercent)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, cylinder with { OxygenPercent = value })"/>
                    </td>
                    <td class="wide-only">
                        <NumberCell Label="@Localized.Format(WebText.CylinderHeliumLabel, name)" Value="cylinder.HeliumPercent"
                                    Invalid="issues[nameof(CylinderInput.HeliumPercent)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, cylinder with { HeliumPercent = value })"/>
                    </td>
                    <td>
                        <NumberCell Label="@Localized.Format(WebText.CylinderSizeLabel, name, Labels.CylinderSize)" Value="cylinder.Size"
                                    Invalid="issues[nameof(CylinderInput.Size)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, CylinderSizes.WithSize(cylinder, value))"/>
                    </td>
                    <td>
                        <NumberCell Label="@Localized.Format(WebText.CylinderPressureLabel, name, Labels.Pressure)" Value="cylinder.StartPressure"
                                    Invalid="issues[nameof(CylinderInput.StartPressure)] is not null"
                                    ValueChanged="value => ChangeCylinderAsync(at, CylinderSizes.WithStartPressure(cylinder, value))"/>
                    </td>
                    @if (imperial)
                    {
                        <td>
                            <NumberCell Label="@Localized.Format(WebText.WorkingPressureLabel, name, Labels.Pressure)" Value="cylinder.RatedPressure"
                                        Invalid="issues[nameof(CylinderInput.RatedPressure)] is not null"
                                        ValueChanged="value => ChangeCylinderAsync(at, CylinderSizes.WithWorkingPressure(cylinder, value))"/>
                        </td>
                    }
                    <td>
                        @if (CylinderRoles.Resolve(Value.Circuit, cylinder) == CylinderPurpose.Oxygen)
                        {
                            <span class="cell-static">@WebText.Oxygen</span>
                        }
                        else
                        {
                            <SelectCell TValue="CylinderPurpose" Label="@Localized.Format(WebText.CylinderUseLabel, name)" Options="CylinderRoles.Selectable(Value.Circuit)"
                                        Text="purpose => Display.Name(purpose, Value.Circuit)" Value="cylinder.Purpose"
                                        Invalid="issues[nameof(CylinderInput.Purpose)] is not null"
                                        ValueChanged="value => ChangeCylinderAsync(at, cylinder with { Purpose = value })"/>
                        }
                    </td>
                    @if (removableCylinders)
                    {
                        <td>
                            <button type="button" class="icon-button" title="@WebText.RemoveCylinder" aria-label="@Localized.Format(WebText.RemoveNamed, name)"
                                    @onclick="() => ChangeAsync(Value with { Cylinders = ListEdit.RemoveAt(Value.Cylinders, at) })"><Icon Name="IconName.Remove"/></button>
                        </td>
                    }
                </tr>
                <RowIssues Columns="columns"
                           Messages="[issues[nameof(CylinderInput.OxygenPercent)], issues[nameof(CylinderInput.HeliumPercent)],
                                      issues[nameof(CylinderInput.Size)],
                                      issues[nameof(CylinderInput.StartPressure)], issues[nameof(CylinderInput.Purpose)], issues[nameof(CylinderInput.RatedPressure)]]"/>
            }
            </tbody>
        </table>
    </div>
    <button type="button" class="secondary" @onclick="() => ChangeAsync(Value with { Cylinders = ListEdit.Add(Value.Cylinders, NewInputs.Cylinder(Units)) })">
        <Icon Name="IconName.Add"/>@WebText.AddCylinder
    </button>
</section>

@code {
    private bool _confirmRemove;
    private int _shownNumber;

    [Parameter]
    public int Number { get; set; } = 1;

    [Parameter]
    public bool CanRemove { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter, EditorRequired]
    public DiveInput Value { get; set; } = default!;

    [Parameter]
    public EventCallback<DiveInput> ValueChanged { get; set; }

    [Parameter]
    public UnitSystem Units { get; set; }

    [Parameter]
    public IssueMap Issues { get; set; } = IssueMap.Empty;

    private UnitLabels Labels => UnitLabels.For(Units);

    protected override void OnParametersSet()
    {
        if (Number != _shownNumber)
        {
            _shownNumber = Number;
            _confirmRemove = false;
        }
    }

    private double IntervalHours => Math.Floor(Value.SurfaceIntervalMinutes / 60);

    private double IntervalMinutes => Value.SurfaceIntervalMinutes - IntervalHours * 60;

    // A cleared name goes back to the default, "Dive 2", rather than an empty title.
    private static string? NameOf(object? value) =>
        value is string name && !string.IsNullOrWhiteSpace(name) ? name.Trim() : null;

    private Task ChangeAsync(DiveInput dive) => ValueChanged.InvokeAsync(CylinderRoles.Apply(dive));

    private async Task RemoveAsync()
    {
        _confirmRemove = false;
        await OnRemove.InvokeAsync();
    }

    private Task ChangeLevelAsync(int index, LevelInput level) =>
        ChangeAsync(Value with { Levels = ListEdit.Replace(Value.Levels, index, level) });

    private Task ChangeCylinderAsync(int index, CylinderInput cylinder) =>
        ChangeAsync(Value with { Cylinders = ListEdit.Replace(Value.Cylinders, index, cylinder) });
}
