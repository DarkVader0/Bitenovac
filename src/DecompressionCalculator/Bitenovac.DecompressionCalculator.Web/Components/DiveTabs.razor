<nav class="dive-tabs no-print" aria-label="@WebText.Dives">
    @for (var index = 0; index < Names.Count; index++)
    {
        var at = index;
        <button type="button" class="dive-tab @(at == Selected ? "selected" : null)" aria-current="@(at == Selected ? "true" : null)"
                @onclick="() => SelectedChanged.InvokeAsync(at)">
            @Names[at]
            @if (DivesWithIssues.Contains(at))
            {
                <span class="badge" aria-label="@Localized.Format(WebText.NeedsAttention, Names[at])"></span>
            }
        </button>
    }
    <button type="button" class="dive-tab add" @onclick="OnAdd"><Icon Name="IconName.Add"/>@WebText.AddDive</button>
</nav>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Names { get; set; } = [];

    [Parameter]
    public int Selected { get; set; }

    [Parameter]
    public EventCallback<int> SelectedChanged { get; set; }

    [Parameter]
    public IReadOnlySet<int> DivesWithIssues { get; set; } = new HashSet<int>();

    [Parameter]
    public EventCallback OnAdd { get; set; }
}
