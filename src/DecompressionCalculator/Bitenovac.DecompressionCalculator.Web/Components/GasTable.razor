<div class="table-scroll">
    <table class="gas">
        <caption>@Caption</caption>
        <thead>
        <tr>
            <th>@WebText.Gas</th>
            <th class="number">@WebText.StartToEnd</th>
            <th class="number">@WebText.Used</th>
            <th class="number">@WebText.Reserve</th>
            <th class="number">@WebText.Left</th>
            @if (RunsShort)
            {
                <th class="number">@WebText.Missing</th>
            }
        </tr>
        </thead>
        <tbody>
        @foreach (var cylinder in Result.Cylinders)
        {
            var amount = GasAmounts.For(cylinder, Quantity, Units);
            <tr class="@State(cylinder)">
                <td class="gas-name">@cylinder.Gas</td>
                <td class="number">@Display.Number(amount.Start) → <span class="gas-end">@Display.Number(amount.End)</span></td>
                <td class="number">@Display.Number(amount.Used)</td>
                <td class="number">@Display.Number(amount.Reserve)</td>
                <td class="number gas-left">@Display.Number(amount.Left)</td>
                @if (RunsShort)
                {
                    <td class="number gas-short">@(cylinder.MissingLitres > 0 ? Display.Number(amount.Missing) : "–")</td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public DiveResult Result { get; set; } = default!;

    [Parameter]
    public UnitSystem Units { get; set; }

    [Parameter]
    public GasQuantity Quantity { get; set; }

    private UnitLabels Labels => UnitLabels.For(Units);

    private bool RunsShort => Result.Cylinders.Any(static cylinder => cylinder.MissingLitres > 0);

    private string Caption
    {
        get
        {
            var caption = Quantity == GasQuantity.Pressure
                ? Localized.Format(WebText.GasCaptionPressure, Labels.Pressure)
                : Localized.Format(WebText.GasCaptionVolume, Labels.GasVolume);
            if (Result.Cylinders.Any(static cylinder => State(cylinder) == "gas-error"))
            {
                caption += WebText.GasCaptionRunsOut;
            }

            if (Result.Cylinders.Any(static cylinder => State(cylinder) == "gas-warning"))
            {
                caption += WebText.GasCaptionReserve;
            }

            return caption;
        }
    }

    private static string? State(CylinderRow cylinder) => cylinder switch
    {
        { IsExhausted: true } or { MissingLitres: > 0 } => "gas-error",
        { ReserveSatisfied: false } => "gas-warning",
        _ => null
    };
}
