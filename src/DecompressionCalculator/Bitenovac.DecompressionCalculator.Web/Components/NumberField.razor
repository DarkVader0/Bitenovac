<label class="field">
    <span class="field-label">@Label</span>
    <span class="field-input">
        <input type="number" inputmode="decimal" step="@Step" value="@_text" class="@(Issue is null ? null : "invalid")"
               aria-invalid="@(Issue is null ? null : "true")" @oninput="OnInputAsync"/>
        @if (Unit is not null)
        {
            <span class="unit">@Unit</span>
        }
    </span>
    @if (Hint is not null)
    {
        <span class="field-hint">@Hint</span>
    }
    @if (Issue is not null)
    {
        <span class="validation-message">@Issue</span>
    }
</label>

@code {
    private string _text = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public string? Unit { get; set; }

    [Parameter]
    public string? Issue { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string Step { get; set; } = "any";

    protected override void OnParametersSet()
    {
        if (!NumberInput.Matches(_text, Value))
        {
            _text = NumberInput.Text(Value);
        }
    }

    private Task OnInputAsync(ChangeEventArgs args)
    {
        _text = args.Value?.ToString() ?? "";
        return ValueChanged.InvokeAsync(NumberInput.Parse(args.Value));
    }
}
