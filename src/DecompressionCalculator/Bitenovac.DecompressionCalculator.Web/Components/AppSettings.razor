@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject PreferencesStore Preferences
@inject IJSRuntime Js
@inject NavigationManager Navigation

<section class="card">
    <div class="field">
        <span class="field-label">@WebText.Theme</span>
        <div class="button-row">
            @foreach (var (theme, label) in Themes)
            {
                <button type="button" class="@(theme == _preferences.Theme ? null : "secondary")"
                        aria-pressed="@(theme == _preferences.Theme ? "true" : "false")" @onclick="() => ChooseThemeAsync(theme)">
                    @label
                </button>
            }
        </div>
    </div>
    <SelectField TValue="string" Label="@WebText.Language" Options="AppLanguages.Tags" Text="AppLanguages.Name"
                 Value="_preferences.Language" ValueChanged="ChooseLanguageAsync"/>
</section>

<section class="card">
    <h2>@WebText.Results</h2>
    <p class="block-note">@WebText.BlocksNote</p>
    <ul class="block-list" @ref="_list">
        @for (var index = 0; index < _preferences.Blocks.Count; index++)
        {
            var setting = _preferences.Blocks[index];
            var name = Name(setting.Block);
            <li class="block-item" @key="setting.Block" data-block="@setting.Block">
                <button type="button" class="block-handle" aria-label="@Localized.Format(WebText.MoveBlock, name)">
                    <Icon Name="IconName.Grip"/>
                </button>
                <span class="block-name">@name</span>
                <button type="button" role="switch" class="switch" aria-label="@name" aria-checked="@(setting.Visible ? "true" : "false")"
                        @onclick="() => ShowAsync(setting.Block, !setting.Visible)"></button>
            </li>
        }
    </ul>
</section>

@code {
    private static readonly (ThemePreference Theme, string Label)[] Themes =
    [
        (ThemePreference.Light, WebText.ThemeLight),
        (ThemePreference.Dark, WebText.ThemeDark),
        (ThemePreference.System, WebText.ThemeSystem)
    ];

    private UserPreferences _preferences = UserPreferences.Default;
    private ElementReference _list;
    private DotNetObjectReference<AppSettings>? _self;
    private IJSObjectReference? _module;
    private IJSObjectReference? _reorder;

    protected override async Task OnInitializedAsync() => _preferences = await Preferences.GetAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/reorder.js");
            _reorder = await _module.InvokeAsync<IJSObjectReference>("attach", _list, _self);
        }
    }

    [JSInvokable]
    public async Task Reorder(int from, int to)
    {
        await SaveAsync(_preferences.Move(_preferences.Blocks[from].Block, to - from));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_reorder is not null)
        {
            await _reorder.InvokeVoidAsync("dispose");
            await _reorder.DisposeAsync();
        }

        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _self?.Dispose();
    }

    private static string Name(ResultBlock block) => block switch
    {
        ResultBlock.Figures => WebText.BlockFigures,
        ResultBlock.Profile => WebText.Profile,
        ResultBlock.Gas => WebText.Gas,
        ResultBlock.Chart => WebText.ProfileChart,
        ResultBlock.GasChecks => WebText.BlockGasChecks,
        _ => WebText.Contingencies
    };

    private Task ChooseThemeAsync(ThemePreference theme) => SaveAsync(_preferences with { Theme = theme });

    private async Task ChooseLanguageAsync(string language)
    {
        await SaveAsync(_preferences with { Language = language });
        Navigation.Refresh(forceReload: true);
    }

    private Task ShowAsync(ResultBlock block, bool visible) => SaveAsync(_preferences.WithVisible(block, visible));

    private async Task SaveAsync(UserPreferences preferences)
    {
        _preferences = preferences;
        await Preferences.SaveAsync(preferences);
    }
}
