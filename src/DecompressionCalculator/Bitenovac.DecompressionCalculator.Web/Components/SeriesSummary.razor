<section class="card">
    <h2>@WebText.Series</h2>
    <div class="table-scroll">
        <table class="profile">
            <thead>
            <tr>
                <th></th>
                <th class="number"><abbr title="@WebText.SurfaceInterval">@WebText.Si</abbr></th>
                <th class="number">@WebText.Depth</th>
                <th class="number">@WebText.Run</th>
                <th class="number">@WebText.Tts</th>
                <th class="number">@WebText.Cns</th>
                <th class="number">@WebText.Otu</th>
            </tr>
            </thead>
            <tbody>
            @for (var index = 0; index < Plan.Dives.Count; index++)
            {
                var at = index;
                <tr class="series-row @(at == Selected ? "row-stop" : null)" @onclick="() => SelectedChanged.InvokeAsync(at)">
                    <td>@Plan.Dives[at].DisplayName(at + 1)</td>
                    <td class="number">@(at == 0 ? "–" : Display.HoursAndMinutes(TimeSpan.FromMinutes(Plan.Dives[at].SurfaceIntervalMinutes)))</td>
                    @if (View.Results[at] is { Succeeded: true } result)
                    {
                        <td class="number">@Display.Number(result.MaximumDepth) @Labels.Depth</td>
                        <td class="number">@Display.Clock(result.TotalRuntime)</td>
                        <td class="number">@Display.Clock(result.TimeToSurface)</td>
                        <td class="number">@Display.Number(result.CnsPercent) %</td>
                        <td class="number">@Display.Number(result.OxygenToleranceUnits)</td>
                    }
                    else if (View.Results[at] is not null)
                    {
                        <td colspan="5" class="series-failed">@WebText.CannotBePlanned</td>
                    }
                    else if (View.IssuesOf(at).Count > 0)
                    {
                        <td colspan="5" class="series-failed">@WebText.Invalid</td>
                    }
                    else
                    {
                        <td colspan="5" class="series-waiting">@Localized.Format(WebText.WaitingForDive, View.FirstInvalidDive + 1)</td>
                    }
                </tr>
            }
            </tbody>
            <caption>@WebText.SeriesCaption</caption>
        </table>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public DivePlanDocument Plan { get; set; } = default!;

    [Parameter, EditorRequired]
    public PlanView View { get; set; } = default!;

    [Parameter]
    public int Selected { get; set; }

    [Parameter]
    public EventCallback<int> SelectedChanged { get; set; }

    private UnitLabels Labels => UnitLabels.For(Plan.Units);
}
