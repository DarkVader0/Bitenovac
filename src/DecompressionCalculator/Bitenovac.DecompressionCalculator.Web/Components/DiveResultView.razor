@implements IDisposable
@inject PreferencesStore Preferences

<section class="card results">
    <h2>@Title</h2>

    @if (!Result.Succeeded)
    {
        <p class="alert alert-danger">@Result.FailureMessage</p>
    }
    else
    {
        @if (!Result.IsValid)
        {
            <div class="alert alert-danger">
                <p>An ascent between levels passes the decompression ceiling. Add a stop or shorten the level.</p>
                <ul>
                    @foreach (var violation in Result.Violations)
                    {
                        <li>
                            @Display.Number(violation.FromDepth) → @Display.Number(violation.ToDepth) @Labels.Depth,
                            ceiling @Display.Number(violation.Ceiling, 1) @Labels.Depth
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!Result.ReserveSatisfied)
        {
            <p class="alert alert-warning">A cylinder does not hold the reserve gas the plan requires.</p>
        }

        @foreach (var block in _blocks)
        {
            switch (block)
            {
                case ResultBlock.Figures:
                    <Figures Result="Result"/>
                    break;
                case ResultBlock.Profile:
                    <h3>Profile</h3>
                    <ProfileTable Result="Result" Units="Units"/>
                    break;
                case ResultBlock.Gas:
                    <h3>Gas</h3>
                    <GasTable Result="Result" Units="Units"/>
                    break;
                case ResultBlock.Chart:
                    <h3>Profile chart</h3>
                    <ProfileChartView Result="Result" Units="Units"/>
                    break;
                case ResultBlock.Contingencies:
                    <h3>Contingencies</h3>
                    @foreach (var contingency in Result.Contingencies)
                    {
                        <ContingencyView Contingency="contingency" Units="Units"/>
                    }

                    break;
            }
        }

        @if (_blocks.Count == 0)
        {
            <p class="block-note">Every part of the results is hidden. Show them again in Settings, under App.</p>
        }
    }
</section>

@code {
    private IReadOnlyList<ResultBlock> _blocks = UserPreferences.Default.VisibleBlocks();

    [Parameter, EditorRequired]
    public DiveResult Result { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Results";

    [Parameter]
    public UnitSystem Units { get; set; }

    private UnitLabels Labels => UnitLabels.For(Units);

    protected override async Task OnInitializedAsync()
    {
        _blocks = (await Preferences.GetAsync()).VisibleBlocks();
        Preferences.Changed += OnChanged;
    }

    public void Dispose() => Preferences.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        _blocks = (await Preferences.GetAsync()).VisibleBlocks();
        StateHasChanged();
    });
}
