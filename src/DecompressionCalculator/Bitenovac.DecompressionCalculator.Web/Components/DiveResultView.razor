<section class="card results">
    <h2>@Title</h2>

    @if (!Result.Succeeded)
    {
        <p class="alert alert-danger">@Result.FailureMessage</p>
    }
    else
    {
        <h3>Profile</h3>
        <div class="results-chart">
            <h3 class="results-chart-title">Profile chart</h3>
            <ProfileChartView Result="Result" Units="Units"/>
        </div>
        <div class="table-scroll">
            <table class="profile">
                <caption>Depth at the end of each phase in @Labels.Depth, time and runtime in minutes</caption>
                <colgroup>
                    <col class="col-phase"/>
                    <col/>
                    <col/>
                    <col/>
                    <col/>
                    @if (ShowsApparatus)
                    {
                        <col class="col-apparatus"/>
                    }
                </colgroup>
                <thead>
                <tr>
                    <th><span class="visually-hidden">Phase</span></th>
                    <th class="number">Depth</th>
                    <th class="number">Time</th>
                    <th class="number">Runtime</th>
                    <th>Gas</th>
                    @if (ShowsApparatus)
                    {
                        <th>Apparatus</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var phase in Result.Profile)
                {
                    <tr class="@(phase.Kind is SegmentKind.Stop or SegmentKind.SafetyStop or SegmentKind.GasSwitch ? "row-stop" : null)">
                        <td class="phase"><PhaseIcon Kind="phase.Kind"/></td>
                        <td class="number">@Display.Number(phase.EndDepth)</td>
                        <td class="number">@Display.Clock(phase.Duration)</td>
                        <td class="number">@Display.Clock(phase.Runtime)</td>
                        <td>@phase.Gas</td>
                        @if (ShowsApparatus)
                        {
                            <td>@phase.Circuit</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <dl class="figures">
            <div><dt>Runtime</dt><dd>@Display.Clock(Result.TotalRuntime)<small> min</small></dd></div>
            <div><dt>TTS</dt><dd>@Display.Clock(ResultFigures.TimeToSurface(Result))<small> min</small></dd></div>
            <div><dt>CNS</dt><dd>@Display.Number(Result.CnsPercent) %</dd></div>
            <div><dt>OTU</dt><dd>@Display.Number(Result.OxygenToleranceUnits)</dd></div>
        </dl>

        @if (!Result.IsValid)
        {
            <div class="alert alert-danger">
                <p>An ascent between levels passes the decompression ceiling. Add a stop or shorten the level.</p>
                <ul>
                    @foreach (var violation in Result.Violations)
                    {
                        <li>
                            @Display.Number(violation.FromDepth) → @Display.Number(violation.ToDepth) @Labels.Depth,
                            ceiling @Display.Number(violation.Ceiling, 1) @Labels.Depth
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!Result.ReserveSatisfied)
        {
            <p class="alert alert-warning">A cylinder does not hold the reserve gas the plan requires.</p>
        }

        <h3>Gas</h3>
        <div class="table-scroll">
            <table class="gas">
                <caption>@GasCaption</caption>
                <thead>
                <tr>
                    <th>Gas</th>
                    <th>Use</th>
                    <th class="number">Pressure</th>
                    <th class="number">Used</th>
                    <th class="number">Reserve</th>
                    <th class="number">Left</th>
                    @if (RunsShort)
                    {
                        <th class="number">Missing</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var cylinder in Result.Cylinders)
                {
                    <tr class="@GasState(cylinder)">
                        <td class="gas-name">@cylinder.Gas</td>
                        <td>@Display.Name(cylinder.Purpose)</td>
                        <td class="number">@Display.Number(cylinder.StartPressure) → <span class="gas-end">@Display.Number(cylinder.EndPressure)</span></td>
                        <td class="number">@Display.Number(cylinder.GasUsed)</td>
                        <td class="number">@Display.Number(cylinder.RequiredReserve)</td>
                        <td class="number gas-left">@Display.Number(cylinder.ProjectedRemaining)</td>
                        @if (RunsShort)
                        {
                            <td class="number gas-short">@(cylinder.Shortfall > 0 ? Display.Number(cylinder.Shortfall) : "–")</td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public DiveResult Result { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Results";

    [Parameter]
    public UnitSystem Units { get; set; }

    private UnitLabels Labels => UnitLabels.For(Units);

    private bool ShowsApparatus => Result.Profile.Any(static phase => phase.Circuit != BreathingLoop.OpenCircuit.ToString());

    private bool RunsShort => Result.Cylinders.Any(static cylinder => cylinder.Shortfall > 0);

    private string GasCaption
    {
        get
        {
            var caption = $"Pressure in {Labels.Pressure}, gas in {Labels.GasVolume} at the surface.";
            if (Result.Cylinders.Any(static cylinder => GasState(cylinder) == "gas-error"))
            {
                caption += " Red: the cylinder runs out.";
            }

            if (Result.Cylinders.Any(static cylinder => GasState(cylinder) == "gas-warning"))
            {
                caption += " Orange: the reserve is not met.";
            }

            return caption;
        }
    }

    private static string? GasState(CylinderRow cylinder) => cylinder switch
    {
        { IsExhausted: true } or { Shortfall: > 0 } => "gas-error",
        { ReserveSatisfied: false } => "gas-warning",
        _ => null
    };
}
