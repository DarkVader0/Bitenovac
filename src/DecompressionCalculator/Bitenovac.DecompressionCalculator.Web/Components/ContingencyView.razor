<details class="contingency">
    <summary>
        <span class="contingency-name">@Name</span>
        @if (Contingency.Result.Succeeded)
        {
            <span class="contingency-summary">
                @Localized.Format(WebText.ContingencySummary, Display.Minutes(Contingency.Result.TotalRuntime), Display.Minutes(Contingency.Result.TimeToSurface))
            </span>
        }
        else
        {
            <span class="contingency-summary contingency-failed">@WebText.CannotBePlanned</span>
        }
    </summary>

    @if (!Contingency.Result.Succeeded)
    {
        <p class="alert alert-danger">@Contingency.Result.FailureMessage</p>
    }
    else
    {
        <ProfileTable Result="Contingency.Result" Units="Units"/>
        <Figures Result="Contingency.Result"/>

        <GasTable Result="Contingency.Result" Units="Units" Quantity="Quantity"/>
    }
</details>

@code {
    [Parameter, EditorRequired]
    public Contingency Contingency { get; set; } = default!;

    [Parameter]
    public UnitSystem Units { get; set; }

    [Parameter]
    public GasQuantity Quantity { get; set; }

    private string Name => Contingency.Kind == ContingencyKind.LostGas
        ? Localized.Format(WebText.ContingencyLost, Contingency.LostGas)
        : Localized.Format(WebText.ContingencyExtended, Display.Number(Contingency.ExtraMinutes), Display.Number(Contingency.ExtraDepth), UnitLabels.For(Units).Depth);
}
