@inject ShareService Share
@inject PreferencesStore Preferences

<div class="drawer-backdrop" @onclick="OnClose"></div>
<aside class="share-sheet" role="dialog" aria-modal="true" aria-label="@WebText.SharePlan" @onkeydown="CloseOnEscape">
    <div class="drawer-header">
        <h2>@WebText.SharePlan</h2>
        <button type="button" class="secondary" @onclick="OnClose"><Icon Name="IconName.Close"/>@WebText.Close</button>
    </div>

    @if (Plan.Dives.Count > 1)
    {
        <div class="field share-scope">
            <span class="field-label">@WebText.WhatToShare</span>
            <div class="button-row">
                <button type="button" class="@(_series ? "secondary" : null)" aria-pressed="@(_series ? "false" : "true")"
                        @onclick="() => _series = false">
                    @WebText.ThisDive
                </button>
                <button type="button" class="@(_series ? null : "secondary")" aria-pressed="@(_series ? "true" : "false")"
                        @onclick="() => _series = true">
                    @WebText.WholeSeries
                </button>
            </div>
        </div>
    }

    <div class="share-options">
        @if (_canShareFiles)
        {
            <button type="button" @onclick="SharePdfAsync"><Icon Name="IconName.Share"/>@WebText.SharePdf</button>
        }
        <button type="button" class="secondary" @onclick="DownloadPdfAsync"><Icon Name="IconName.Download"/>@WebText.DownloadPdf</button>
        <button type="button" class="secondary" @onclick="PrintAsync"><Icon Name="IconName.Print"/>@WebText.Print</button>
    </div>

    @if (_status is not null)
    {
        <p class="share-status" role="status">@_status</p>
    }
</aside>

@code {
    private bool _canShareFiles;
    private bool _series;
    private IReadOnlyList<ResultBlock> _blocks = UserPreferences.Default.VisibleBlocks();
    private string? _status;

    [Parameter, EditorRequired]
    public DivePlanDocument Plan { get; set; } = default!;

    /// <summary>
    /// Gets or sets the zero-based index of the dive the sheet is made of: the one open in the plan.
    /// </summary>
    [Parameter]
    public int Dive { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string Title => string.IsNullOrWhiteSpace(Plan.Name) ? FileNames.Fallback : Plan.Name;

    private string FileName => FileNames.Pdf(_series
        ? Localized.Format(WebText.AllDivesFile, Title)
        : Plan.Dives.Count > 1 || !string.IsNullOrWhiteSpace(Plan.Dives[Dive].Name)
            ? Localized.Format(WebText.DiveFile, Title, Plan.Dives[Dive].DisplayName(Dive + 1))
            : Title);

    protected override async Task OnInitializedAsync()
    {
        _canShareFiles = await Share.CanShareFilesAsync();
        _blocks = (await Preferences.GetAsync()).VisibleBlocks();
    }

    private byte[] Sheet() => _series
        ? DiveSheet.CreateSeries(Plan, DateTime.UtcNow, AppVersion.Current, _blocks)
        : DiveSheet.Create(Plan, Dive, DateTime.UtcNow, AppVersion.Current, _blocks);

    private async Task SharePdfAsync()
    {
        var pdf = Sheet();
        var outcome = await Share.ShareFileAsync(pdf, FileName, ShareService.PdfType, Title, Title);
        if (outcome == ShareOutcome.Failed)
        {
            await Share.DownloadAsync(pdf, FileName, ShareService.PdfType);
            _status = WebText.ShareFallback;
        }
        else
        {
            _status = null;
        }
    }

    private async Task DownloadPdfAsync()
    {
        await Share.DownloadAsync(Sheet(), FileName, ShareService.PdfType);
        _status = WebText.Downloaded;
    }

    private async Task PrintAsync()
    {
        await Share.PrintPdfAsync(Sheet());
        await OnClose.InvokeAsync();
    }

    private Task CloseOnEscape(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
