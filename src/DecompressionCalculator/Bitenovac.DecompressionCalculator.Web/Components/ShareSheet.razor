@inject ShareService Share

<div class="drawer-backdrop" @onclick="OnClose"></div>
<aside class="share-sheet" role="dialog" aria-modal="true" aria-label="Share plan" @onkeydown="CloseOnEscape">
    <div class="drawer-header">
        <h2>Share plan</h2>
        <button type="button" class="secondary" @onclick="OnClose"><Icon Name="IconName.Close"/>Close</button>
    </div>

    <div class="share-options">
        @if (_canShareFiles)
        {
            <button type="button" @onclick="SharePdfAsync"><Icon Name="IconName.Share"/>Share PDF</button>
        }
        <button type="button" class="secondary" @onclick="DownloadPdfAsync"><Icon Name="IconName.Download"/>Download PDF</button>
        <button type="button" class="secondary" @onclick="PrintAsync"><Icon Name="IconName.Print"/>Print</button>
    </div>

    @if (_status is not null)
    {
        <p class="share-status" role="status">@_status</p>
    }
</aside>

@code {
    private bool _canShareFiles;
    private string? _status;

    [Parameter, EditorRequired]
    public DivePlanDocument Plan { get; set; } = default!;

    /// <summary>
    /// Gets or sets the zero-based index of the dive the sheet is made of: the one open in the plan.
    /// </summary>
    [Parameter]
    public int Dive { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string Title => string.IsNullOrWhiteSpace(Plan.Name) ? FileNames.Fallback : Plan.Name;

    private string FileName => FileNames.Pdf(Plan.Dives.Count > 1 || !string.IsNullOrWhiteSpace(Plan.Dives[Dive].Name)
        ? $"{Title} - {Plan.Dives[Dive].DisplayName(Dive + 1)}"
        : Title);

    protected override async Task OnInitializedAsync()
    {
        _canShareFiles = await Share.CanShareFilesAsync();
    }

    private byte[] Sheet() => DiveSheet.Create(Plan, Dive, DateTime.UtcNow, AppVersion.Current);

    private async Task SharePdfAsync()
    {
        var pdf = Sheet();
        var outcome = await Share.ShareFileAsync(pdf, FileName, ShareService.PdfType, Title, Title);
        if (outcome == ShareOutcome.Failed)
        {
            await Share.DownloadAsync(pdf, FileName, ShareService.PdfType);
            _status = "Sharing is not available here, so the PDF was downloaded instead.";
        }
        else
        {
            _status = null;
        }
    }

    private async Task DownloadPdfAsync()
    {
        await Share.DownloadAsync(Sheet(), FileName, ShareService.PdfType);
        _status = "Downloaded.";
    }

    private async Task PrintAsync()
    {
        await Share.PrintPdfAsync(Sheet());
        await OnClose.InvokeAsync();
    }

    private Task CloseOnEscape(KeyboardEventArgs args) => args.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;
}
