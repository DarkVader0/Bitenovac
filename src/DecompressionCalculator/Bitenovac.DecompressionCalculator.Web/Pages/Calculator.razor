@using Microsoft.JSInterop
@page "/calculator"
@inject PlanStore Store
@inject NavigationManager Navigation
@inject CalculatorReturn Returning
@inject IJSRuntime Js

<PageTitle>@WebText.GasTools</PageTitle>

<header class="plan-header no-print">
    <button type="button" class="calculator-logo" title="@WebText.BackToPlan" aria-label="@WebText.BackToPlan" @onclick="BackAsync">
        <img src="icon.svg" alt="" width="40" height="40"/>
    </button>
    <h1 class="calculator-title">@WebText.GasTools</h1>
</header>

@if (!_loaded)
{
    return;
}

<section class="card">
    <p class="block-note">
        @Localized.Format(WebText.ToolsEnvironment, Names.Of(_settings.Salinity), Display.Number(_settings.Altitude), Labels.Depth)
        @(_settings.OxygenNarcotic ? WebText.ToolsNarcoticOn : WebText.ToolsNarcoticOff)
    </p>

    <section class="gas-tool">
        <h3>@WebText.MaximumOperatingDepth</h3>
        <div class="field-pair">
            <NumberField Label="@WebText.O2Subscript" Unit="%" Value="_modOxygen" ValueChanged="value => _modOxygen = value"/>
            <NumberField Label="@WebText.Po2Limit" Unit="bar" Value="_modPo2" ValueChanged="value => _modPo2 = value"/>
        </div>
        <p class="gas-tool-result" role="status">
            @WebText.Mod <strong>@Result(() => $"{Display.Number(Math.Floor(GasMath.MaximumOperatingDepth(_modOxygen, _modPo2, _settings, _units)))} {Labels.Depth}")</strong>
        </p>
    </section>

    <section class="gas-tool">
        <h3>@WebText.EquivalentNarcoticDepth</h3>
        <div class="field-pair">
            <NumberField Label="@WebText.O2Subscript" Unit="%" Value="_endOxygen" ValueChanged="value => _endOxygen = value"/>
            <NumberField Label="@WebText.He" Unit="%" Value="_endHelium" ValueChanged="value => _endHelium = value"/>
        </div>
        <NumberField Label="@WebText.Depth" Unit="@Labels.Depth" Value="_endDepth" ValueChanged="value => _endDepth = value"/>
        <p class="gas-tool-result" role="status">
            @WebText.End <strong>@Result(() => $"{Display.Number(Math.Ceiling(GasMath.EquivalentNarcoticDepth(_endOxygen, _endHelium, _endDepth, _settings, _units)))} {Labels.Depth}")</strong>
            · @WebText.DensityLower <strong>@Result(() => $"{Display.Number(GasMath.Density(_endOxygen, _endHelium, _endDepth, _settings, _units), 1)} g/L")</strong>
        </p>
    </section>

    <section class="gas-tool">
        <h3>@WebText.BestMix</h3>
        <NumberField Label="@WebText.DeepestDepth" Unit="@Labels.Depth" Value="_mixDepth" ValueChanged="value => _mixDepth = value"/>
        <div class="field-pair">
            <NumberField Label="@WebText.Po2Limit" Unit="bar" Value="_mixPo2" ValueChanged="value => _mixPo2 = value"/>
            <NumberField Label="@WebText.EndLimit" Unit="@Labels.Depth" Value="_mixEnd" ValueChanged="value => _mixEnd = value"/>
        </div>
        <p class="gas-tool-result" role="status">@WebText.BestMix <strong>@Result(BestMixText)</strong></p>
    </section>
</section>

@code {
    private bool _loaded;
    private bool _fromPlan;
    private (Guid? Plan, int? Dive) _loadedFor;
    private PlannerSettings _settings = PlannerSettings.Default(UnitSystem.Metric);
    private UnitSystem _units = UnitSystem.Metric;
    private string _backTo = "";
    private double _modOxygen = 50;
    private double _modPo2;
    private double _endOxygen = 21;
    private double _endHelium = 35;
    private double _endDepth;
    private double _mixDepth;
    private double _mixPo2;
    private double _mixEnd;

    [SupplyParameterFromQuery(Name = "plan")]
    public Guid? PlanId { get; set; }

    [SupplyParameterFromQuery(Name = "dive")]
    public int? DiveNumber { get; set; }

    private UnitLabels Labels => UnitLabels.For(_units);

    protected override void OnInitialized() => _fromPlan = Returning.FromPlan;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedFor == (PlanId, DiveNumber))
        {
            return;
        }

        _loadedFor = (PlanId, DiveNumber);
        var plan = PlanId is { } id ? await Store.LoadAsync(id) : null;
        plan ??= await Store.LastOpenedAsync() is { } last ? await Store.LoadAsync(last) : null;
        if (plan is null || plan.Dives.Count == 0)
        {
            Navigation.NavigateTo("", replace: true);
            return;
        }

        var dive = Math.Clamp((DiveNumber ?? 1) - 1, 0, plan.Dives.Count - 1);
        _settings = plan.SettingsFor(dive);
        _units = plan.Units;
        _backTo = $"plan/{plan.Id:D}?dive={dive + 1}";
        _modPo2 = _settings.DecoPo2;
        _mixPo2 = _settings.BottomPo2;
        var imperial = _units == UnitSystem.Imperial;
        _endDepth = imperial ? 150 : 45;
        _mixDepth = imperial ? 200 : 60;
        _mixEnd = imperial ? 100 : 30;
        _loaded = true;
    }

    private async Task BackAsync()
    {
        Returning.FromPlan = false;
        if (_fromPlan)
        {
            await Js.InvokeVoidAsync("history.back");
            return;
        }

        Navigation.NavigateTo(_backTo, replace: true);
    }

    private string BestMixText()
    {
        var mix = GasMath.BestMix(_mixDepth, _mixPo2, _mixEnd, _settings, _units);
        return GasMixture.FromPercent(mix.PercentO2, mix.PercentHe).ToString();
    }

    private static string Result(Func<string> calculate)
    {
        try
        {
            return calculate();
        }
        catch (ArgumentOutOfRangeException)
        {
            return "–";
        }
    }
}
