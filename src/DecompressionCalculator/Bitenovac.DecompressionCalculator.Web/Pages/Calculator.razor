@using Microsoft.JSInterop
@page "/calculator"
@inject PlanStore Store
@inject NavigationManager Navigation
@inject CalculatorReturn Returning
@inject IJSRuntime Js

<PageTitle>@WebText.GasTools</PageTitle>

<header class="plan-header no-print">
    <button type="button" class="calculator-logo" title="@WebText.BackToPlan" aria-label="@WebText.BackToPlan" @onclick="BackAsync">
        <img src="icon.svg" alt="" width="40" height="40"/>
    </button>
    <h1 class="calculator-title">@WebText.GasTools</h1>
</header>

@if (!_loaded)
{
    return;
}

<section class="card">
    <GasCalculator @key="_loadedFor" Settings="_settings" Units="_units"/>
</section>

@code {
    private bool _loaded;
    private bool _fromPlan;
    private (Guid? Plan, int? Dive) _loadedFor;
    private PlannerSettings _settings = PlannerSettings.Default(UnitSystem.Metric);
    private UnitSystem _units = UnitSystem.Metric;
    private string _backTo = "";

    [SupplyParameterFromQuery(Name = "plan")]
    public Guid? PlanId { get; set; }

    [SupplyParameterFromQuery(Name = "dive")]
    public int? DiveNumber { get; set; }

    protected override void OnInitialized() => _fromPlan = Returning.FromPlan;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedFor == (PlanId, DiveNumber))
        {
            return;
        }

        _loadedFor = (PlanId, DiveNumber);
        var plan = PlanId is { } id ? await Store.LoadAsync(id) : null;
        plan ??= await Store.LastOpenedAsync() is { } last ? await Store.LoadAsync(last) : null;
        if (plan is null || plan.Dives.Count == 0)
        {
            Navigation.NavigateTo("", replace: true);
            return;
        }

        var dive = Math.Clamp((DiveNumber ?? 1) - 1, 0, plan.Dives.Count - 1);
        _settings = plan.SettingsFor(dive);
        _units = plan.Units;
        _backTo = $"plan/{plan.Id:D}?dive={dive + 1}";
        _loaded = true;
    }

    private async Task BackAsync()
    {
        Returning.FromPlan = false;
        if (_fromPlan)
        {
            await Js.InvokeVoidAsync("history.back");
            return;
        }

        Navigation.NavigateTo(_backTo, replace: true);
    }
}
