@page "/plan/{Id:guid}"
@inject PlanStore Store
@inject NavigationManager Navigation

<PageTitle>@(_plan?.Name ?? "Bitenovac")</PageTitle>

@if (_missing)
{
    <h1>@WebText.PlanNotFound</h1>
    <p>@WebText.PlanNotSaved</p>
    <a href="plans">@WebText.ShowSavedPlans</a>
    return;
}

@if (_plan is null || _view is null)
{
    return;
}

<PlanSidebar Current="_plan"/>

<header class="plan-header no-print">
    <a class="icon-button plans-button" href="plans" title="@WebText.Plans" aria-label="@WebText.Plans">
        <Icon Name="IconName.Plans"/>
    </a>
    <input class="plan-name" type="text" aria-label="@WebText.PlanName" value="@_plan.Name"
           @onchange="args => ChangeAsync(_plan with { Name = args.Value as string ?? string.Empty })"/>
    <button type="button" class="icon-button" title="@WebText.GasTools" aria-label="@WebText.GasTools" @onclick="OpenCalculator">
        <Icon Name="IconName.Calculator"/>
    </button>
    <button type="button" class="icon-button" title="@WebText.Share" aria-label="@WebText.Share" @onclick="() => _shareOpen = true">
        <Icon Name="IconName.Share"/>
    </button>
    <button type="button" class="icon-button settings-button" title="@WebText.Settings" aria-label="@WebText.Settings" aria-expanded="@_settingsOpen"
            @onclick="() => _settingsOpen = true">
        <Icon Name="IconName.Settings"/>
        @if (SettingsHaveIssues)
        {
            <span class="badge" aria-label="@WebText.SettingsNeedAttention"></span>
        }
    </button>
</header>

<h1 class="print-only">@(string.IsNullOrWhiteSpace(_plan.Name) ? FileNames.Fallback : _plan.Name)</h1>

<DiveTabs Names="DiveNames" Selected="_selected" SelectedChanged="index => _selected = index"
          DivesWithIssues="DivesWithIssues" OnAdd="() => AddDiveAsync(_plan)"/>

<DiveEditor Value="_plan.Dives[_selected]" Number="_selected + 1" CanRemove="_plan.Dives.Count > 1" Units="_plan.Units"
            Issues="_issues.Scope(nameof(DivePlanDocument.Dives), _selected)" OnRemove="() => RemoveDiveAsync(_plan)"
            ValueChanged="dive => ChangeAsync(_plan with { Dives = ListEdit.Replace(_plan.Dives, _selected, dive) })"/>

@if (_view.PlanIssues.Count > 0)
{
    <section class="card results">
        <h2>@WebText.SettingsInvalid</h2>
        <div class="alert alert-danger">
            <p>@WebText.NoDiveUntilFixed</p>
            <ul>
                @foreach (var issue in _view.PlanIssues)
                {
                    <li>@IssueText.Describe(issue)</li>
                }
            </ul>
            <button type="button" class="secondary" @onclick="OpenPlanSettings">@WebText.OpenSettings</button>
        </div>
    </section>
}
else
{
    var title = _plan.Dives.Count > 1 || !string.IsNullOrWhiteSpace(_plan.Dives[_selected].Name) ? Localized.Format(WebText.ResultsOf, DiveNames[_selected]) : WebText.Results;
    @if (_view.Results[_selected] is { } result)
    {
        <DiveResultView Result="result" Units="_plan.Units" Title="@title"/>
    }
    else
    {
        <section class="card results">
            <h2>@title</h2>
            @if (_view.IssuesOf(_selected) is { Count: > 0 } issues)
            {
                <div class="alert alert-danger">
                    <p>@(_plan.Dives.Count > 1 ? Localized.Format(WebText.DiveIsInvalid, DiveNames[_selected]) : WebText.TheDiveIsInvalid)</p>
                    <ul>
                        @foreach (var issue in issues)
                        {
                            <li>@IssueText.Describe(issue)</li>
                        }
                    </ul>
                </div>
            }
            @if (_view.FirstInvalidDive is { } blocking && blocking < _selected)
            {
                <div class="alert alert-warning">
                    <p>
                        @Localized.Format(WebText.BlockedByEarlierDive, DiveNames[blocking])
                    </p>
                    <button type="button" class="secondary" @onclick="() => _selected = blocking">@Localized.Format(WebText.GoTo, DiveNames[blocking])</button>
                </div>
            }
        </section>
    }

    @if (_plan.Dives.Count > 1)
    {
        <SeriesSummary Plan="_plan" View="_view" Selected="_selected" SelectedChanged="index => _selected = index"/>
    }
}

@if (_shareOpen)
{
    <ShareSheet Plan="_plan" Dive="_selected" OnClose="() => _shareOpen = false"/>
}

@if (_settingsOpen)
{
    <div class="drawer-backdrop settings-backdrop" @onclick="() => _settingsOpen = false"></div>
}

<aside class="drawer settings-panel @(_settingsOpen ? "open" : null)" role="@(_settingsOpen ? "dialog" : "complementary")"
       aria-modal="@(_settingsOpen ? "true" : null)" aria-label="@WebText.Settings" @onkeydown="CloseOnEscape">
    <div class="drawer-header">
        <h2>@WebText.Settings</h2>
        <button type="button" class="settings-done" @onclick="() => _settingsOpen = false">@WebText.Done</button>
    </div>

    <nav class="dive-tabs settings-tabs" aria-label="@WebText.Settings">
        <button type="button" class="dive-tab @(_appSettings ? null : "selected")" aria-current="@(_appSettings ? null : "true")"
                @onclick="() => _appSettings = false">
            @WebText.Plan
        </button>
        <button type="button" class="dive-tab @(_appSettings ? "selected" : null)" aria-current="@(_appSettings ? "true" : null)"
                @onclick="() => _appSettings = true">
            @WebText.App
        </button>
    </nav>

    @if (_appSettings)
    {
        <AppSettings/>
    }
    else
    {
        <section class="card">
            <div class="field-grid">
                <div class="field">
                    <span class="field-label">@WebText.Units</span>
                    <div class="button-row">
                        <button type="button" class="@(_plan.Units == UnitSystem.Metric ? null : "secondary")"
                                aria-pressed="@(_plan.Units == UnitSystem.Metric ? "true" : "false")"
                                @onclick="() => ChangeAsync(PlanConverter.Convert(_plan, UnitSystem.Metric))">
                            @WebText.Metric
                        </button>
                        <button type="button" class="@(_plan.Units == UnitSystem.Imperial ? null : "secondary")"
                                aria-pressed="@(_plan.Units == UnitSystem.Imperial ? "true" : "false")"
                                @onclick="() => ChangeAsync(PlanConverter.Convert(_plan, UnitSystem.Imperial))">
                            @WebText.Imperial
                        </button>
                    </div>
                </div>
                <div class="field another-plan">
                    <span class="field-label">@WebText.AnotherPlan</span>
                    <button type="button" class="secondary" @onclick="() => StartOverAsync(_plan.Units)"><Icon Name="IconName.Add"/>@WebText.NewPlan</button>
                </div>
            </div>
        </section>

        <AlgorithmEditor Value="_plan.Algorithm" Issues="_issues.Scope(nameof(DivePlanDocument.Algorithm))"
                         ValueChanged="algorithm => ChangeAsync(_plan with { Algorithm = algorithm })"/>

        <DiveSettingsScope DiveName="@_plan.Dives[_selected].DisplayName(_selected + 1)" DiveCount="_plan.Dives.Count"
                           Shared="_plan.Dives[_selected].Settings is null"
                           HasChanges="_plan.Dives[_selected].Settings is { } own && own != _plan.Settings"
                           SharedChanged="shared => ShareSettingsAsync(_plan, shared)"/>

        <SettingsEditor Value="_plan.SettingsFor(_selected)" Units="_plan.Units" Issues="SettingsIssues"
                        ValueChanged="settings => ChangeSettingsAsync(_plan, settings)"/>
    }
</aside>

@code {
    private DivePlanDocument? _plan;
    private PlanView? _view;
    private IssueMap _issues = IssueMap.Empty;
    private bool _settingsOpen;
    private bool _appSettings;
    private bool _shareOpen;
    private bool _missing;
    private Guid _loadedId;
    private int _selected;

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "dive")]
    public int? DiveNumber { get; set; }

    private IReadOnlyList<string> DiveNames => [.. _plan!.Dives.Select(static (dive, index) => dive.DisplayName(index + 1))];

    private IReadOnlySet<int> DivesWithIssues => _issues.IndexesWithIssues(nameof(DivePlanDocument.Dives));

    private bool SettingsHaveIssues => _view?.PlanIssues.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId)
        {
            return;
        }

        _loadedId = Id;
        _selected = Math.Max(0, (DiveNumber ?? 1) - 1);
        _settingsOpen = false;
        var saved = await Store.LoadAsync(Id);
        _missing = saved is not { Dives.Count: > 0 };
        if (saved is { Dives.Count: > 0 })
        {
            Show(saved with { Dives = [.. saved.Dives.Select(CylinderRoles.Apply)] });
            await Store.MarkOpenedAsync(Id);
        }
    }

    private async Task StartOverAsync(UnitSystem units)
    {
        var plan = PlanCopies.New(units, DateTime.UtcNow);
        await Store.SaveAsync(plan);
        Navigation.NavigateTo($"plan/{plan.Id:D}");
    }

    private IssueMap SettingsIssues => _plan!.Dives[_selected].Settings is null
        ? _issues.Scope(nameof(DivePlanDocument.Settings))
        : _issues.Scope(nameof(DivePlanDocument.Dives), _selected).Scope(nameof(DiveInput.Settings));

    private Task ShareSettingsAsync(DivePlanDocument plan, bool shared) =>
        ChangeAsync(plan with
        {
            Dives = ListEdit.Replace(plan.Dives, _selected, plan.Dives[_selected] with { Settings = shared ? null : plan.Settings })
        });

    private Task ChangeSettingsAsync(DivePlanDocument plan, PlannerSettings settings) =>
        plan.Dives[_selected].Settings is null
            ? ChangeAsync(plan with { Settings = settings })
            : ChangeAsync(plan with { Dives = ListEdit.Replace(plan.Dives, _selected, plan.Dives[_selected] with { Settings = settings }) });

    private async Task AddDiveAsync(DivePlanDocument plan)
    {
        _selected = plan.Dives.Count;
        await ChangeAsync(plan with { Dives = ListEdit.Add(plan.Dives, NewInputs.NextDive(plan)) });
    }

    private async Task RemoveDiveAsync(DivePlanDocument plan)
    {
        var removed = _selected;
        _selected = Math.Max(0, removed - 1);
        await ChangeAsync(plan with { Dives = ListEdit.RemoveAt(plan.Dives, removed) });
    }

    private void OpenCalculator() => Navigation.NavigateTo($"calculator?plan={_plan!.Id:D}&dive={_selected + 1}");

    private void OpenPlanSettings()
    {
        _appSettings = false;
        _settingsOpen = true;
    }

    private void CloseOnEscape(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _settingsOpen = false;
        }
    }

    private async Task ChangeAsync(DivePlanDocument plan)
    {
        var updated = plan with { ModifiedAt = DateTime.UtcNow };
        Show(updated);
        await Store.SaveAsync(updated);
    }

    private void Show(DivePlanDocument plan)
    {
        _plan = plan;
        _selected = Math.Clamp(_selected, 0, plan.Dives.Count - 1);
        _view = PlanView.Calculate(plan);
        _issues = IssueMap.From(_view.Issues);
    }
}
