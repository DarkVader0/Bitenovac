@page "/plans"
@inject PlanStore Store
@inject NavigationManager Navigation

<PageTitle>@Localized.Format(WebText.PlansTitle, "Bitenovac")</PageTitle>

<header class="plan-header">
    <h1 class="page-title">@WebText.Plans</h1>
    <button type="button" @onclick="NewAsync"><Icon Name="IconName.Add"/>@WebText.NewPlan</button>
</header>

@if (_plans is null)
{
    return;
}

@if (_plans.Count == 0)
{
    <p class="empty">@WebText.NoSavedPlans</p>
}
else
{
    <ul class="plan-list">
        @foreach (var plan in _plans)
        {
            <li class="plan-item">
                <a class="plan-link" href="@($"plan/{plan.Id:D}")">
                    <span class="plan-item-name">@(string.IsNullOrWhiteSpace(plan.Name) ? WebText.UntitledPlan : plan.Name)</span>
                    <span class="plan-item-meta">@PlanCopies.Describe(plan)</span>
                    <span class="plan-item-meta">@Localized.Format(WebText.ChangedAt, plan.ModifiedAt.ToLocalTime().ToString("g"))</span>
                </a>
                @if (_confirmDelete == plan.Id)
                {
                    <div class="button-row">
                        <button type="button" class="danger" @onclick="() => DeleteAsync(plan.Id)">@WebText.Delete</button>
                        <button type="button" class="secondary" @onclick="() => _confirmDelete = null">@WebText.Cancel</button>
                    </div>
                }
                else
                {
                    <div class="button-row">
                        <button type="button" class="secondary" @onclick="() => DuplicateAsync(plan)"><Icon Name="IconName.Copy"/>@WebText.Duplicate</button>
                        <button type="button" class="secondary" @onclick="() => _confirmDelete = plan.Id"><Icon Name="IconName.Remove"/>@WebText.Delete</button>
                    </div>
                }
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<DivePlanDocument>? _plans;
    private Guid? _confirmDelete;

    protected override async Task OnInitializedAsync() => _plans = await Store.ListAsync();

    private async Task NewAsync()
    {
        var units = _plans is [var latest, ..] ? latest.Units : UnitSystem.Metric;
        var plan = PlanCopies.New(units, DateTime.UtcNow);
        await Store.SaveAsync(plan);
        Navigation.NavigateTo($"plan/{plan.Id:D}");
    }

    private async Task DuplicateAsync(DivePlanDocument plan)
    {
        await Store.SaveAsync(PlanCopies.Duplicate(plan, DateTime.UtcNow));
        _plans = await Store.ListAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        await Store.DeleteAsync(id);
        _confirmDelete = null;
        _plans = await Store.ListAsync();
    }
}
