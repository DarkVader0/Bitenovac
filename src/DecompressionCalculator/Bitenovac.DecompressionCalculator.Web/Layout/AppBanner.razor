@implements IDisposable
@inject PwaService Pwa

@if (Pwa.State.UpdateReady)
{
    <div class="app-banner no-print" role="status">
        <span>@WebText.UpdateReady</span>
        <button type="button" @onclick="ReloadAsync" disabled="@_reloading"><Icon Name="IconName.Reload"/>@WebText.Reload</button>
    </div>
}
else if (Pwa.State.CanInstall)
{
    <div class="app-banner no-print" role="status">
        <span>@WebText.InstallOffline</span>
        <div class="app-banner-actions">
            <button type="button" @onclick="InstallAsync"><Icon Name="IconName.Install"/>@WebText.Install</button>
            <button type="button" class="app-banner-dismiss" @onclick="DismissAsync">@WebText.NotNow</button>
        </div>
    </div>
}
else if (Pwa.State.ManualInstall is { } platform)
{
    <div class="app-banner no-print" role="status">
        <span>
            @(platform switch
            {
                "mac" => WebText.InstallMac,
                "android-firefox" => WebText.InstallFirefox,
                _ => WebText.InstallIos
            })
        </span>
        <div class="app-banner-actions">
            <button type="button" class="app-banner-dismiss" @onclick="DismissAsync">@WebText.GotIt</button>
        </div>
    </div>
}

@code {
    private bool _reloading;

    protected override void OnInitialized() => Pwa.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Pwa.StartAsync();
        }
    }

    public void Dispose() => Pwa.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ReloadAsync()
    {
        _reloading = true;
        await Pwa.ApplyUpdateAsync();
    }

    private async Task InstallAsync() => await Pwa.InstallAsync();

    private async Task DismissAsync() => await Pwa.DismissInstallAsync();
}
