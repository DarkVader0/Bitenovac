<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

    <!-- Unconditional, so it outranks the drop version Official passes in: these projects release together. -->
    <PropertyGroup>
        <VersionPrefix>10.4.0</VersionPrefix>
    </PropertyGroup>

</Project>
