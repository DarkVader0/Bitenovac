<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Bitenovac.RemoteBuildTool</RootNamespace>
        <MinimumLineCoverage>95</MinimumLineCoverage>
        <MinimumBranchCoverage>90</MinimumBranchCoverage>
    </PropertyGroup>

    <!-- Versioned independently of the repository: CI runs a published release, not this source. -->
    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>remotebuildtool</ToolCommandName>
        <IsPackable>true</IsPackable>
        <PackageId>Bitenovac.RemoteBuildTool</PackageId>
        <VersionPrefix>1.2.0</VersionPrefix>
        <Description>Content-hashed build, test and coverage pipeline for the Bitenovac repository.</Description>
        <Authors>Radivoje Milutinovic</Authors>
        <Company>Bitenovac</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/DarkVader0/Bitenovac-Decompression</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Bitenovac.RemoteBuildTool.Core\Bitenovac.RemoteBuildTool.Core.csproj"/>
        <ProjectReference Include="..\Bitenovac.RemoteBuildTool.Testing\Bitenovac.RemoteBuildTool.Testing.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Bitenovac.RemoteBuildTool.Unit.Tests"/>
        <InternalsVisibleTo Include="Bitenovac.RemoteBuildTool.Integration.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator"/>
        <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime"/>
        <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime"/>
        <PackageReference Include="DuckDB.NET.Data.Full"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Telemetry/Sql/*.sql" LogicalName="Telemetry.%(Filename).sql"/>
    </ItemGroup>

</Project>
