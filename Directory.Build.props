<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
    
    <PropertyGroup>
        <RepositoryTargetFramework>net10.0</RepositoryTargetFramework>
        <TargetFramework Condition="'$(TargetFramework)' == '' AND '$(TargetFrameworks)' == ''">$(RepositoryTargetFramework)</TargetFramework>
    </PropertyGroup>

    <PropertyGroup>
        <IsLibrary Condition="'$(IsLibrary)' == '' AND ($(MSBuildProjectDirectory.Contains('src/libraries')) OR $(MSBuildProjectDirectory.Contains('src\libraries')))">true</IsLibrary>
        <IsLibrary Condition="'$(IsLibrary)' == ''">false</IsLibrary>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLibrary)' == 'true'">

    </PropertyGroup>
    <PropertyGroup Condition="'$(IsLibrary)' == 'false'">

    </PropertyGroup>

    <PropertyGroup>
        <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.1.0</VersionPrefix>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <Deterministic>true</Deterministic>
        <IsPackable>true</IsPackable>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/DarkVader0/Bitenovac-Decompression</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Authors>Radivoje Milutinovic</Authors>
        <Company>Bitenovac</Company>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
    </PropertyGroup>

    <PropertyGroup>
        <IsTestProject Condition="'$(IsTestProject)' == '' AND $(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        
        <CacheTestResults Condition="'$(CacheTestResults)' == ''">true</CacheTestResults>
    </PropertyGroup>

    
    <PropertyGroup>
        <MinimumLineCoverage Condition="'$(MinimumLineCoverage)' == ''">100</MinimumLineCoverage>
        <MinimumBranchCoverage Condition="'$(MinimumBranchCoverage)' == ''">100</MinimumBranchCoverage>

        <ExcludeFromCoverage Condition="'$(ExcludeFromCoverage)' == '' AND '$(IsTestProject)' == 'true'">true</ExcludeFromCoverage>
        <ExcludeFromCoverage Condition="'$(ExcludeFromCoverage)' == ''">false</ExcludeFromCoverage>
    </PropertyGroup>
</Project>